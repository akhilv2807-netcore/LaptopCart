@model IEnumerable<Product>
    
    <div class="row mb-3 align-items-center">
        <div class="col-md-4">
            <h2 class="text-secondary">Product List</h2>
        </div>
        <div class="col-md-8 text-end">
            <a asp-action="Create" class="btn btn-dark text-white"><i class="bi bi-plus-circle"></i> Add Product</a>
        </div>
    </div>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Product Id</th>
                <th>Product Name</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var product in Model)
        {
            <tr>
                <td><img src="@product.ImagePath" width="100" height="100"/></td>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i></a>
                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }   
        </tbody>
    </table>
